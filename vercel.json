{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/join", "destination": "/index.html" },
    { "source": "/sender/:code", "destination": "/index.html" },
    { "source": "/g/:code", "destination": "/index.html" },
    { "source": "/s/:code", "destination": "/index.html" },
    { "source": "/download/:code", "destination": "/index.html" },
    { "source": "/expired", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/send-files-without-signup", "destination": "/send-files-without-signup.html" },
    { "source": "/share-files-with-qr-code", "destination": "/share-files-with-qr-code.html" },
    { "source": "/self-destructing-file-sharing", "destination": "/self-destructing-file-sharing.html" },
    { "source": "/password-protected-file-transfer", "destination": "/password-protected-file-transfer.html" },
    { "source": "/share-text-and-code-snippets", "destination": "/share-text-and-code-snippets.html" },
    { "source": "/airdrop-alternative", "destination": "/airdrop-alternative.html" },
    { "source": "/security", "destination": "/security.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/report-abuse", "destination": "/report-abuse.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/sender/:code",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/g/:code",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/s/:code",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/download/:code",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/expired",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src fonts.gstatic.com; connect-src 'self' https: wss:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src 'self' https:; object-src 'none';" }
      ]
    }
  ]
}
